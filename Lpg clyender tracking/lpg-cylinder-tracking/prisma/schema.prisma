generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  ADMIN
  MANAGER
  DELIVERY_PERSON
}

enum CylinderSize {
  KG_5
  KG_12
  KG_25
  KG_45
}

enum CylinderStatus {
  FULL
  EMPTY
  IN_USE
  DAMAGED
  IN_TRANSIT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
}

enum PaymentStatus {
  PAID
  PARTIAL
  DUE
  REFUNDED
}

enum TransactionType {
  REFILL
  DISPATCH
  RETURN
  DAMAGE
  REPAIR
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id                   String                @id @default(cuid()) @map("id")
  name                 String                @map("name")
  nameBn               String?               @map("name_bn")
  email                String                @unique @map("email")
  phone                String                @unique @map("phone")
  password             String                @map("password")
  role                 Role                  @default(DELIVERY_PERSON) @map("role")
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  // Relations
  deliveries           Delivery[]
  cylinderTransactions CylinderTransaction[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Customer {
  id        String     @id @default(cuid()) @map("id")
  name      String     @map("name")
  nameBn    String?    @map("name_bn")
  phone     String     @unique @map("phone")
  altPhone  String?    @map("alt_phone")
  address   String     @map("address")
  addressBn String?    @map("address_bn")
  area      String     @map("area")
  areaBn    String?    @map("area_bn")
  notes     String?    @map("notes")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  // Relations
  orders    Order[]
  cylinders Cylinder[]
  invoices  Invoice[]

  @@index([area])
  @@index([isActive])
  @@map("customers")
}

model Cylinder {
  id                String                @id @default(cuid()) @map("id")
  serialNumber      String                @unique @map("serial_number")
  size              CylinderSize          @map("size")
  status            CylinderStatus        @default(EMPTY) @map("status")
  currentCustomerId String?               @map("current_customer_id")
  notes             String?               @map("notes")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  // Relations
  customer          Customer?             @relation(fields: [currentCustomerId], references: [id], onDelete: SetNull)
  transactions      CylinderTransaction[]
  orderItems        OrderItem[]

  @@index([status])
  @@index([size])
  @@index([currentCustomerId])
  @@index([size, status])
  @@map("cylinders")
}

model Order {
  id              String      @id @default(cuid()) @map("id")
  orderNumber     String      @unique @map("order_number")
  customerId      String      @map("customer_id")
  status          OrderStatus @default(PENDING) @map("status")
  deliveryDate    DateTime?   @map("delivery_date")
  deliveryAddress String?     @map("delivery_address")
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  notes           String?     @map("notes")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderItems      OrderItem[]
  delivery        Delivery?
  invoice         Invoice?

  @@index([customerId])
  @@index([status])
  @@index([deliveryDate])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           String       @id @default(cuid()) @map("id")
  orderId      String       @map("order_id")
  cylinderSize CylinderSize @map("cylinder_size")
  quantity     Int          @map("quantity")
  unitPrice    Decimal      @map("unit_price") @db.Decimal(10, 2)
  totalPrice   Decimal      @map("total_price") @db.Decimal(10, 2)
  cylinderId   String?      @map("cylinder_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relations
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cylinder     Cylinder?    @relation(fields: [cylinderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([cylinderId])
  @@index([cylinderSize])
  @@map("order_items")
}

model Delivery {
  id               String      @id @default(cuid()) @map("id")
  orderId          String      @unique @map("order_id")
  deliveryPersonId String      @map("delivery_person_id")
  status           OrderStatus @default(PENDING) @map("status")
  assignedAt       DateTime    @default(now()) @map("assigned_at")
  startedAt        DateTime?   @map("started_at")
  completedAt      DateTime?   @map("completed_at")
  notes            String?     @map("notes")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  // Relations
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPerson   User        @relation(fields: [deliveryPersonId], references: [id], onDelete: Restrict)

  @@index([deliveryPersonId])
  @@index([status])
  @@index([assignedAt])
  @@map("deliveries")
}

model Invoice {
  id            String        @id @default(cuid()) @map("id")
  invoiceNumber String        @unique @map("invoice_number")
  orderId       String        @unique @map("order_id")
  customerId    String        @map("customer_id")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  dueAmount     Decimal       @map("due_amount") @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(DUE) @map("payment_status")
  issuedAt      DateTime      @default(now()) @map("issued_at")
  dueDate       DateTime?     @map("due_date")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments      Payment[]

  @@index([customerId])
  @@index([orderId])
  @@index([paymentStatus])
  @@index([issuedAt])
  @@index([dueDate])
  @@map("invoices")
}

model Payment {
  id            String        @id @default(cuid()) @map("id")
  invoiceId     String        @map("invoice_id")
  amount        Decimal       @map("amount") @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  transactionId String?       @map("transaction_id")
  notes         String?       @map("notes")
  paidAt        DateTime      @default(now()) @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paymentMethod])
  @@index([paidAt])
  @@index([transactionId])
  @@map("payments")
}

model CylinderTransaction {
  id            String          @id @default(cuid()) @map("id")
  cylinderId    String          @map("cylinder_id")
  type          TransactionType @map("type")
  fromStatus    CylinderStatus  @map("from_status")
  toStatus      CylinderStatus  @map("to_status")
  performedById String          @map("performed_by_id")
  notes         String?         @map("notes")
  createdAt     DateTime        @default(now()) @map("created_at")

  // Relations
  cylinder      Cylinder        @relation(fields: [cylinderId], references: [id], onDelete: Cascade)
  performedBy   User            @relation(fields: [performedById], references: [id], onDelete: Restrict)

  @@index([cylinderId])
  @@index([performedById])
  @@index([type])
  @@index([createdAt])
  @@map("cylinder_transactions")
}

model CylinderPrice {
  id            String       @id @default(cuid()) @map("id")
  size          CylinderSize @map("size")
  price         Decimal      @map("price") @db.Decimal(10, 2)
  depositAmount Decimal      @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  effectiveFrom DateTime     @map("effective_from")
  effectiveTo   DateTime?    @map("effective_to")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@unique([size, effectiveFrom])
  @@index([size, isActive])
  @@index([effectiveFrom, effectiveTo])
  @@map("cylinder_prices")
}
